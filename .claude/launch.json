{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "server:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8001", "--reload", "--reload-dir", "backend"],
      "port": 8001
    }
  ]
}
